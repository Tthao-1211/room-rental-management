@model Project_65133295.Models.EmployeeGroup

@{
    ViewBag.Title = "Employee Group Details";
    ViewBag.PageTitle = "Employee Group Details";
    ViewBag.PageDescription = "View permission group details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.GroupCode - @Model.GroupName</h1>
            <p class="text-sm text-gray-500">@Model.Description</p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-semibold @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-700")">
            @(Model.IsActive ? "Active" : "Inactive")
        </span>
    </div>

    <div>
        <a href="@Url.Action("EmployeeGroups", "Admin_65133295")" class="inline-flex items-center px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition">
            Back
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div class="p-4 border rounded-xl">
            <h2 class="font-semibold mb-2">VAN HANH</h2>
            <ul class="space-y-1">
                <li>View room: @(Model.CanViewRoom ? "Yes" : "No")</li>
                <li>Edit room: @(Model.CanEditRoom ? "Yes" : "No")</li>
                <li>Create booking: @(Model.CanCreateBooking ? "Yes" : "No")</li>
                <li>Approve booking: @(Model.CanApproveBooking ? "Yes" : "No")</li>
                <li>Room dashboard: @(Model.CanViewRoomDashboard ? "Yes" : "No")</li>
            </ul>
        </div>
        <div class="p-4 border rounded-xl">
            <h2 class="font-semibold mb-2">TAI CHINH</h2>
            <ul class="space-y-1">
                <li>Create contract: @(Model.CanCreateContract ? "Yes" : "No")</li>
                <li>Manage contract: @(Model.CanManageContract ? "Yes" : "No")</li>
                <li>Create payment: @(Model.CanCreatePayment ? "Yes" : "No")</li>
                <li>Track payment: @(Model.CanTrackPayment ? "Yes" : "No")</li>
                <li>Revenue dashboard: @(Model.CanViewRevenueDashboard ? "Yes" : "No")</li>
            </ul>
        </div>
        <div class="p-4 border rounded-xl">
            <h2 class="font-semibold mb-2">CSKH</h2>
            <ul class="space-y-1">
                <li>View tenant profile: @(Model.CanViewTenantProfile ? "Yes" : "No")</li>
                <li>Manage review: @(Model.CanManageReview ? "Yes" : "No")</li>
                <li>Booking history: @(Model.CanViewBookingHistory ? "Yes" : "No")</li>
            </ul>
        </div>
    </div>
</div>

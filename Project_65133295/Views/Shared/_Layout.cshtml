<!DOCTYPE html>
@{
    // Helper to determine active class for navigation links
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    Func<string, string, string> GetNavClass = (ctrl, act) => {
        bool isActive = string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(act, currentAction, StringComparison.OrdinalIgnoreCase);
        return isActive ? "text-base font-bold text-navy transition" : "text-base font-medium text-sky hover:text-ice transition";
    };
    
    Func<string, string, string> GetMobileNavClass = (ctrl, act) => {
        bool isActive = string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(act, currentAction, StringComparison.OrdinalIgnoreCase);
        return isActive 
            ? "block px-4 py-2 text-sm font-bold text-navy bg-ice rounded-lg transition" 
            : "block px-4 py-2 text-sm font-medium text-sky hover:bg-ice hover:text-navy rounded-lg transition";
    };
}
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Thanh Thảo Stay</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Custom blue palette per design
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ice: '#FFFFFF'                    }, 
                    fontFamily: {
                        sans: ['Inter', 'Roboto', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
    <style>
        .glassmorphism {
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .navbar-scrolled {
            background: linear-gradient(90deg, #ffffff, #FFF8E7) !important;
            box-shadow: 0 2px 10px rgba(201,168,76,0.15);
            border-bottom: 2px solid #C9A84C;
        }

        /* Small utility to render 1.5px border where needed */
        .border-1-5 { border-width: 1.5px; }

        /* Ensure mobile menu button is keyboard accessible */
        #mobile-menu-btn { outline: none; }
    </style>
</head>
<body class="font-sans bg-white text-gray-700">
    
    <!-- Navigation Bar - fixed top, 3-column layout per design -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" style="background:#ffffff; height:52px; padding-left:32px; padding-right:32px;">
        <div class="container mx-auto h-full flex items-center justify-between">
            <!-- Left: Logo -->
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Guest_65133295")" class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#ffffff; border:2px solid #B1C9EF;">
                        <!-- Mini house icon (white) -->
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M3 11.5L12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-5H9v5H4a1 1 0 0 1-1-1V11.5z" fill="#ffffff"/>
                        </svg>
                    </div>
                    <span class="text-[16px] font-bold" style="color:#004cff;">Thanh Thảo Stay</span>
                </a>
            </div>

            <!-- Center: Navigation links -->
            <div class="flex-1 flex items-center justify-center">
                <div class="hidden md:flex items-center space-x-6">
                    <a href="@Url.Action("Index", "Guest_65133295")" class="text-[13px] font-bold text-gray-900 uppercase hover:text-gray-400 transition">Home</a>
                    <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="text-[13px] font-bold text-gray-900 uppercase hover:text-gray-400 transition">Rooms</a>
                    <a href="@Url.Action("BookingGuide", "Guest_65133295")" class="text-[13px] font-bold text-gray-900 uppercase hover:text-gray-400 transition">Booking Guide</a>
                </div>
            </div>

            <!-- Right: Auth Buttons -->
            <div class="flex items-center space-x-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.Action("Logout", "Guest_65133295")" class="text-[13px] font-semibold inline-flex items-center justify-center min-w-[80px] rounded-[6px] py-1.5 border-1-5" style="border-color:rgba(0,0,0,0.06); color:#1E3A5F; background:transparent;">
                        Logout
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Guest_65133295")" class="text-[13px] font-semibold inline-flex items-center justify-center min-w-[80px] rounded-[6px] py-1.5 border-1-5" style="border-color:rgba(0,0,0,0.06); color:#1E3A5F; background:transparent;">
                        Login
                    </a>
                    <a href="@Url.Action("Register", "Guest_65133295")" class="text-[13px] font-semibold inline-flex items-center justify-center min-w-[80px] rounded-[6px] py-1.5" style="border: 1.5px solid rgba(0,0,0,0.06); background: transparent; color: #1E3A5F; ">
                        Sign Up
                    </a>
                }
                <!-- Mobile menu button -->
                <button id="mobile-menu-btn" class="ml-2 md:hidden" aria-expanded="false" aria-label="Open menu">
                    <svg class="w-6 h-6" fill="none" stroke="#1E3A5F" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Menu (same links) -->
        <div id="mobile-menu" class="hidden md:hidden">
            <div class="px-4 pb-4 pt-2 flex flex-col space-y-2">
                <a href="@Url.Action("Index", "Guest_65133295")" class="@GetMobileNavClass("Guest_65133295", "Index")">Home</a>
                <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="@GetMobileNavClass("Guest_65133295", "SearchRoom")">Rooms</a>
                <a href="@Url.Action("BookingGuide", "Guest_65133295")" class="@GetMobileNavClass("Guest_65133295", "BookingGuide")">Booking Guide</a>
                <div class="pt-2 border-t border-   sky/20"></div>
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.Action("Logout", "Guest_65133295")" class="block px-4 py-2 text-sm font-semibold text-navy bg-ice rounded-lg text-center">Logout</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Guest_65133295")" class="block px-4 py-2 text-sm font-semibold text-ice rounded-lg text-center border-1-5" style="border-color:#8AAEE0;">Login</a>
                    <a href="@Url.Action("Register", "Guest_65133295")" class="block px-4 py-2 text-sm font-semibold text-navy bg-mid rounded-lg text-center">Sign Up</a>
                }
            </div>
        </div>
    </nav>
    
    <!-- Global Error Message (Unauthorized access) -->
    @if (TempData["Error"] != null)
    {
        <div class="fixed top-20 right-4 z-[100]">
            <div class="bg-red-600 text-white px-6 py-3 rounded-lg shadow-2xl flex items-center space-x-3 border-2 border-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <span class="font-bold">@TempData["Error"]</span>
            </div>
        </div>
    }

    <!-- Main Content (with top padding for fixed navbar)-->
    <main class="pt-14">
        @RenderBody()
    </main>
    
    <!-- Footer (unchanged other than color tokens) -->
    <footer class="bg-white mt-16 border-t" style="border-top-color: #628ECB;">
        <div class="container mx-auto px-4 py-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-6">
                <div>
                    <h3 class="text-lg font-bold" style="color:#004cff; margin-bottom:0.5rem;">Thanh Thảo Stay</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Trusted room rental management system. Over 500+ quality rooms in Ho Chi Minh City.
                    </p>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-700 mb-3">Links</h3>
                    <ul class="space-y-2 text-sm text-gray-500">
                        <li><a href="@Url.Action("Index", "Guest_65133295")" class="hover:text-steel transition">Home</a></li>
                        <li><a href="@Url.Action("SearchRoom", "Guest_65133295")" class="hover:text-steel transition">Rooms</a></li>
                        <li><a href="@Url.Action("BookingGuide", "Guest_65133295")" class="hover:text-steel transition">Booking Guide</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-700 mb-3">Contact</h3>
                    <ul class="space-y-2 text-sm text-gray-500">
                        <li class="flex items-center">Hotline: 0764307704</li>
                        <li class="flex items-center">Email: ptthanhthaoxxx@gmail.com</li>
                        <li class="flex items-start">02 Đoàn Trần Nghiệp, Vĩnh Phước, TP. Nha Trang</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-200 pt-6 text-center">
                <p class="text-xs font-light text-gray-500">
                    &copy; @DateTime.Now.Year Thanh Thảo Stay. All rights reserved.
                </p>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    
    <!-- Custom Scripts -->
    <script>
        // Sticky Navbar on Scroll (keeps color)
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
                navbar.classList.remove('glassmorphism');
            } else {
                navbar.classList.remove('navbar-scrolled');
                navbar.classList.add('glassmorphism');
            }
        });
        
        // Mobile Menu Toggle
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenu.classList.toggle('hidden');
        });
    </script>
    
    @RenderSection("scripts", required: false)
</body>
</html>

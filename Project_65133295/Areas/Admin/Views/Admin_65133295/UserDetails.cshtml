@model Project_65133295.Models.User

@{
    ViewBag.Title = "User Details";
    ViewBag.PageTitle = "User Details";
    ViewBag.PageDescription = "View full account information";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var employeeProfile = Model.EmployeeProfile;
    var employeeGroup = employeeProfile?.EmployeeGroup;

    string FullName = string.Join(" ", new[] { Model.FirstName, Model.LastName }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim();
    if (string.IsNullOrWhiteSpace(FullName))
    {
        FullName = "-";
    }

    string GenderText = string.IsNullOrWhiteSpace(Model.Gender) ? "-" : Model.Gender;
    string AddressText = string.Join(", ", new[] { Model.Street, Model.Ward, Model.District, Model.City }.Where(s => !string.IsNullOrWhiteSpace(s)));
    if (string.IsNullOrWhiteSpace(AddressText))
    {
        AddressText = "-";
    }

    string RoleText = Model.Role.ToString();
}

<div class="space-y-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="flex flex-col xl:flex-row xl:items-start xl:justify-between gap-6">
            <div class="flex items-start gap-4">
                <div class="h-20 w-20 rounded-2xl bg-primary/10 border border-primary/20 overflow-hidden flex items-center justify-center flex-shrink-0">
                    @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                    {
                        <img src="@Model.Avatar" alt="Avatar" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <span class="text-primary font-bold text-2xl">@((string.IsNullOrWhiteSpace(Model.FirstName) ? "U" : Model.FirstName.Substring(0, 1).ToUpper()))</span>
                    }
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">@FullName</h1>
                    <p class="text-sm text-gray-500">@Model.Username</p>
                    <p class="text-sm text-gray-500">@Model.Email</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                            @(Model.IsActive ? "Active" : "Locked")
                        </span>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                            @RoleText
                        </span>
                        @if (Model.IsEmailVerified)
                        {
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">Email verified</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">Email not verified</span>
                        }
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a href="@Url.Action("ManageUsers", "Admin_65133295", new { area = "Admin" })" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition">
                    Back
                </a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-xs uppercase tracking-wider text-gray-500">User ID</p>
            <p class="mt-2 text-2xl font-bold text-gray-900">@Model.UserID</p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-xs uppercase tracking-wider text-gray-500">Created</p>
            <p class="mt-2 text-lg font-bold text-gray-900">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-xs uppercase tracking-wider text-gray-500">Updated</p>
            <p class="mt-2 text-lg font-bold text-gray-900">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-xs uppercase tracking-wider text-gray-500">Last Login</p>
            <p class="mt-2 text-lg font-bold text-gray-900">@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Account Info</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Username</dt>
                    <dd class="font-medium text-gray-900">@Model.Username</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Email</dt>
                    <dd class="font-medium text-gray-900 break-all">@Model.Email</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Phone</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Role</dt>
                    <dd class="font-medium text-gray-900">@RoleText</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Status</dt>
                    <dd class="font-medium text-gray-900">@(Model.IsActive ? "Active" : "Locked")</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Email verified</dt>
                    <dd class="font-medium text-gray-900">@(Model.IsEmailVerified ? "Yes" : "No")</dd>
                </div>
            </dl>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Personal Info</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Full name</dt>
                    <dd class="font-medium text-gray-900">@FullName</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">First name</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.FirstName) ? "-" : Model.FirstName)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Last name</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.LastName) ? "-" : Model.LastName)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Date of birth</dt>
                    <dd class="font-medium text-gray-900">@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "-")</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Gender</dt>
                    <dd class="font-medium text-gray-900">@GenderText</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Identity number</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.IdentityNumber) ? "-" : Model.IdentityNumber)</dd>
                </div>
            </dl>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Address Info</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Street</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.Street) ? "-" : Model.Street)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Ward</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.Ward) ? "-" : Model.Ward)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">District</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.District) ? "-" : Model.District)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">City</dt>
                    <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.City) ? "-" : Model.City)</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="text-gray-500">Full address</dt>
                    <dd class="font-medium text-gray-900 text-right">@AddressText</dd>
                </div>
            </dl>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Employee Info</h2>
            @if (employeeProfile != null)
            {
                <dl class="space-y-3 text-sm">
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Employee Code</dt>
                        <dd class="font-medium text-gray-900">@employeeProfile.EmployeeCode</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Group Code</dt>
                        <dd class="font-medium text-gray-900">@(employeeGroup?.GroupCode ?? "-")</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Group Name</dt>
                        <dd class="font-medium text-gray-900">@(employeeGroup?.GroupName ?? "-")</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Department</dt>
                        <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(employeeProfile.Department) ? "-" : employeeProfile.Department)</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Position</dt>
                        <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(employeeProfile.Position) ? "-" : employeeProfile.Position)</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Hired Date</dt>
                        <dd class="font-medium text-gray-900">@(employeeProfile.HiredDate.HasValue ? employeeProfile.HiredDate.Value.ToString("dd/MM/yyyy") : "-")</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Employee Status</dt>
                        <dd class="font-medium text-gray-900">@(employeeProfile.IsActive ? "Active" : "Inactive")</dd>
                    </div>
                    <div class="flex items-start justify-between gap-4">
                        <dt class="text-gray-500">Note</dt>
                        <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(employeeProfile.Note) ? "-" : employeeProfile.Note)</dd>
                    </div>
                </dl>
            }
            else
            {
                <p class="text-sm text-gray-500">No employee profile assigned.</p>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Activity Summary</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Logs</dt><dd class="font-medium text-gray-900">@Model.ActivityLogs.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Notifications received</dt><dd class="font-medium text-gray-900">@Model.Notifications.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Notifications sent</dt><dd class="font-medium text-gray-900">@Model.Notifications1.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Email tokens</dt><dd class="font-medium text-gray-900">@Model.EmailVerificationTokens.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Reset tokens</dt><dd class="font-medium text-gray-900">@Model.PasswordResetTokens.Count</dd></div>
            </dl>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Booking / Contract</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Bookings as tenant</dt><dd class="font-medium text-gray-900">@Model.Bookings1.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Bookings approved</dt><dd class="font-medium text-gray-900">@Model.Bookings.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Rooms managed</dt><dd class="font-medium text-gray-900">@Model.Rooms.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Rooms rented</dt><dd class="font-medium text-gray-900">@Model.Rooms1.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Reviews</dt><dd class="font-medium text-gray-900">@Model.Reviews.Count</dd></div>
            </dl>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Finance Summary</h2>
            <dl class="space-y-3 text-sm">
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Payments as admin</dt><dd class="font-medium text-gray-900">@Model.Payments.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Payments as user</dt><dd class="font-medium text-gray-900">@Model.Payments1.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Employee profiles</dt><dd class="font-medium text-gray-900">@Model.EmployeeProfiles.Count</dd></div>
                <div class="flex items-start justify-between gap-4"><dt class="text-gray-500">Total related records</dt><dd class="font-medium text-gray-900">@((Model.ActivityLogs.Count + Model.Notifications.Count + Model.Notifications1.Count + Model.EmailVerificationTokens.Count + Model.PasswordResetTokens.Count + Model.Bookings.Count + Model.Bookings1.Count + Model.Rooms.Count + Model.Rooms1.Count + Model.Payments.Count + Model.Payments1.Count + Model.Reviews.Count + Model.EmployeeProfiles.Count))</dd></div>
            </dl>
        </div>
    </div>
</div>

@model IEnumerable<Project_65133295.Models.Room>
@{
    ViewBag.Title = "Home - ThanhThao Stay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- SECTION 1: HERO -->
<section class="py-12">
    <div class="container-max">
        <div class="hero-wrapper rounded-large overflow-hidden grid">
            <div class="hero-left">
                <div class="eyebrow">WELCOME TO</div>
                <h1 class="hero-title">ThanhThao <span style="color:var(--color-secondary);">Stay</span></h1>
                <p class="hero-desc">Nền tảng quản lý và tìm kiếm phòng trọ hiện đại tại Nha Trang.</p>
                <div class="hero-cta">
                    <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="btn champagne">Explore Rooms</a>
                    <a href="@Url.Action("BookingGuide", "Guest_65133295")" class="btn outline-white">Book Now</a>
                </div>
            </div>
            <div class="hero-media">
                <img src="~/public/rooms/HHHH_1.JPG" alt="Căn hộ cao cấp" class="h-[520px] w-full object-cover" />
            </div>
        </div>

        <!-- STATS card overlapping hero -->
        <div class="stat-card card slide-up -mt-10">
            <div class="container-max mx-auto flex flex-wrap gap-6 justify-between items-center">
                <div class="stat-item text-center">
                    <div class="icon"><i class="fas fa-home"></i></div>
                    <div class="text-2xl font-bold">120+</div>
                    <div class="text-sm text-text-secondary">Available Rooms</div>
                </div>
                <div class="stat-item text-center">
                    <div class="icon"><i class="fas fa-users"></i></div>
                    <div class="text-2xl font-bold">500+</div>
                    <div class="text-sm text-text-secondary">Happy Customers</div>
                </div>
                <div class="stat-item text-center">
                    <div class="icon"><i class="fas fa-star"></i></div>
                    <div class="text-2xl font-bold">98%</div>
                    <div class="text-sm text-text-secondary">Customer Satisfaction</div>
                </div>
                <div class="stat-item text-center">
                    <div class="icon"><i class="fas fa-headset"></i></div>
                    <div class="text-2xl font-bold">24/7</div>
                    <div class="text-sm text-text-secondary">Support</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3: OUR SERVICES -->
<section class="py-16">
    <div class="container-max">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold">Our Services</h2>
            <p class="text-text-secondary">Comprehensive solutions</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="card p-6 text-center hover:translate-y-[-6px] transition-transform">
                <div class="service-icon"><i class="fas fa-building"></i></div>
                <h3 class="font-semibold text-lg mb-2">Room Rentals</h3>
                <p class="text-text-secondary text-sm">Find premium rooms and apartments across Nha Trang.</p>
            </div>
            <div class="card p-6 text-center hover:translate-y-[-6px] transition-transform">
                <div class="service-icon"><i class="fas fa-cogs"></i></div>
                <h3 class="font-semibold text-lg mb-2">Management Operations</h3>
                <p class="text-text-secondary text-sm">Tools for contracts, billing and tenant management.</p>
            </div>
            <div class="card p-6 text-center hover:translate-y-[-6px] transition-transform">
                <div class="service-icon"><i class="fas fa-hands-helping"></i></div>
                <h3 class="font-semibold text-lg mb-2">Resident Support</h3>
                <p class="text-text-secondary text-sm">24/7 support for maintenance and inquiries.</p>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 4: FEATURED ROOMS -->
<section class="py-16 bg-surface">
    <div class="container-max">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold">Featured Rooms</h2>
                <p class="text-text-secondary text-sm">Hand-picked premium listings</p>
            </div>
            <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="btn btn-secondary">View All Rooms</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
            @if (Model != null && Model.Any())
            {
                foreach(var room in Model)
                {
                        var mainImg = room.RoomImages != null && room.RoomImages.Any() ? room.RoomImages.OrderBy(r => r.DisplayOrder).First().ImageUrl.TrimStart('~', '/') : "public/rooms/placeholder.jpg";
                        var imgUrl = Url.Content("~/" + mainImg);
                        <div class="card overflow-hidden">
                            <div class="card-image-wrap">
                                    <img src="@(imgUrl)" alt="@room.Title" class="w-full h-[180px] object-cover" />
                                </div>
                            <div class="p-4">
                                <h3 class="font-semibold">@room.Title</h3>
                                <div class="text-sm text-text-secondary">@room.RoomNumber</div>
                                <div class="mt-3 flex items-center justify-between">
                                    <div class="text-lg font-bold">@((room.Price).ToString("N0") + " " + room.PriceUnit)</div>
                                    <a href="@Url.Action("RoomDetails", "Guest_65133295", new { id = room.RoomID })" class="btn btn-secondary">View Details</a>
                                </div>
                            </div>
                        </div>
                }
            }
            else
            {
                <div class="text-text-secondary">No featured rooms available at the moment.</div>
            }
        </div>
    </div>
</section>

<!-- SECTION 5: WHY CHOOSE US -->
<section class="py-16 bg-[#F5F3EF]">
    <div class="container-max">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold">Why Choose Us</h2>
            <p class="text-text-secondary">Benefits that set us apart</p>
        </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="p-6 text-center">
                    <div class="w-16 h-16 mx-auto rounded-full bg-primary text-white flex items-center justify-center mb-4"><i class="fas fa-check"></i></div>
                    <h4 class="font-semibold">Trustworthy</h4>
                    <p class="text-text-secondary text-sm">Verified listings and transparent information.</p>
                </div>
                <div class="p-6 text-center">
                    <div class="w-16 h-16 mx-auto rounded-full bg-primary text-white flex items-center justify-center mb-4"><i class="fas fa-lock"></i></div>
                    <h4 class="font-semibold">Secure & Safe</h4>
                    <p class="text-text-secondary text-sm">Secure payment and property safeguards.</p>
                </div>
                <div class="p-6 text-center">
                    <div class="w-16 h-16 mx-auto rounded-full bg-primary text-white flex items-center justify-center mb-4"><i class="fas fa-wallet"></i></div>
                    <h4 class="font-semibold">Competitive Pricing</h4>
                    <p class="text-text-secondary text-sm">Transparent rates and no hidden fees.</p>
                </div>
                <div class="p-6 text-center">
                    <div class="w-16 h-16 mx-auto rounded-full bg-primary text-white flex items-center justify-center mb-4"><i class="fas fa-seedling"></i></div>
                    <h4 class="font-semibold">Green Living Space</h4>
                    <p class="text-text-secondary text-sm">Eco-friendly and comfortable environments.</p>
                </div>
            </div>
    </div>
</section>

<!-- SECTION 6: CTA -->
<section class="py-16">
    <div class="container-max">
        <div class="rounded-large p-8 md:p-12 text-white bg-cta-gradient">
            <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-4">
                <div class="text-left md:w-3/4">
                    <h3 class="text-3xl font-semibold mb-2">Ready to find your next home?</h3>
                    <p class="text-sm opacity-90">Browse premium listings curated by ThanhThao Stay and book with confidence.</p>
                </div>
                <div class="md:w-auto">
                    <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="btn btn-primary">Explore Rooms Now</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Animations moved to global CSS -->

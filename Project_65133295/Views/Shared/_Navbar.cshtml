@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    Func<string, string, bool> IsActive = (ctrl, act) =>
    {
        return string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(act, currentAction, StringComparison.OrdinalIgnoreCase);
    };
}
<nav id="navbar" class="site-navbar">
    <div class="nav-container">
        <div class="brand">
            <a href="@Url.Action("Index", "Guest_65133295")" class="brand-link" style="display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none;">
                <div style="width:44px;height:44px;border-radius:9999px;overflow:hidden;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.08);background:transparent;">
                    <img src="~/public/logo.jpg" alt="ThanhThao Stay" style="width:44px;height:44px;object-fit:cover;display:block;" />
                </div>
                <span style="font-family:Playfair Display, serif; font-size:18px;">ThanhThao Stay</span>
            </a>
        </div>

        <div class="nav-center">
            <a href="@Url.Action("Index", "Guest_65133295")" class="nav-link @(IsActive("Guest_65133295", "Index") ? "active" : "")">Home</a>
            <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="nav-link @(IsActive("Guest_65133295", "SearchRoom") ? "active" : "")">Rooms</a>
            <a href="@Url.Action("BookingGuide", "Guest_65133295")" class="nav-link @(IsActive("Guest_65133295", "BookingGuide") ? "active" : "")">Booking Guide</a>
        </div>

        <div class="nav-actions">
            @if (User.Identity.IsAuthenticated)
            {
                <a href="@Url.Action("Logout", "Guest_65133295")" class="nav-btn login">Logout</a>
            }
            else
            {
                <a href="@Url.Action("Login", "Guest_65133295")" class="nav-btn login">Login</a>
                <a href="@Url.Action("Register", "Guest_65133295")" class="nav-btn signup">Sign Up</a>
            }
            <button id="mobile-menu-btn" class="nav-btn login md:hidden" aria-expanded="false" aria-label="Open menu">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden">
        <div style="padding:12px; display:flex; flex-direction:column; gap:8px; background:var(--color-primary);">
            <a href="@Url.Action("Index", "Guest_65133295")" class="nav-link">Home</a>
            <a href="@Url.Action("SearchRoom", "Guest_65133295")" class="nav-link">Rooms</a>
            <a href="@Url.Action("BookingGuide", "Guest_65133295")" class="nav-link">Booking Guide</a>
        </div>
    </div>

</nav>

<script>
    // Mobile Menu Toggle (scoped)
    (function(){
        const btn = document.getElementById('mobile-menu-btn');
        if(!btn) return;
        btn.addEventListener('click', function(){
            const mobileMenu = document.getElementById('mobile-menu');
            if(mobileMenu) mobileMenu.classList.toggle('hidden');
        });
    })();

    // Sticky behavior handled by CSS position:fixed; keep optional class toggle for visual changes on scroll
    window.addEventListener('scroll', function(){
        const navbar = document.getElementById('navbar');
        if(!navbar) return;
        if(window.scrollY > 10){
            navbar.classList.add('shadow-sm');
        } else {
            navbar.classList.remove('shadow-sm');
        }
    });
</script>

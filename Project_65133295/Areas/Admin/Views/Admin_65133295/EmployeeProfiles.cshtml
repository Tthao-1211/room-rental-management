@model IEnumerable<Project_65133295.Models.EmployeeProfile>

@{
    ViewBag.Title = "Employee Profiles";
    ViewBag.PageTitle = "Employee Profiles";
    ViewBag.PageDescription = "Manage employee records";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Employee Profiles</h1>
            <p class="text-sm text-gray-500">Total profiles: @(Model?.Count() ?? 0)</p>
        </div>
        <a href="@Url.Action("CreateEmployeeProfile")" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold">
            Create Profile
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">User</th>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Group</th>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Code</th>
                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Position</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model != null && Model.Any())
                {
                    foreach (var profile in Model)
                    {
                        <tr>
                            <td class="px-6 py-4 text-gray-900 font-semibold">@(profile.User != null ? profile.User.Username : "N/A")</td>
                            <td class="px-6 py-4 text-gray-700">@(profile.EmployeeGroup != null ? profile.EmployeeGroup.GroupCode + " - " + profile.EmployeeGroup.GroupName : "N/A")</td>
                            <td class="px-6 py-4 text-gray-700">@profile.EmployeeCode</td>
                            <td class="px-6 py-4 text-gray-700">@profile.Position</td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="@Url.Action("EditEmployeeProfile", new { id = profile.ProfileID })" class="text-sm text-yellow-600">Edit</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

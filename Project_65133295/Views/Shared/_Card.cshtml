@using Project_65133295.Models
@{
    string imageUrl = null;
    string title = null;
    string location = null;
    string price = null;
    string detailsUrl = "#";

    // If ViewData provided (from previous implementation)
    if (ViewData["ImageUrl"] != null) imageUrl = ViewData["ImageUrl"] as string;
    if (ViewData["Title"] != null) title = ViewData["Title"] as string;
    if (ViewData["Location"] != null) location = ViewData["Location"] as string;
    if (ViewData["Price"] != null) price = ViewData["Price"] as string;
    if (ViewData["DetailsUrl"] != null) detailsUrl = ViewData["DetailsUrl"] as string;

    // If Model is Room, map real data
    var roomModel = Model as Room;
    if (roomModel != null)
    {
        title = title ?? roomModel.Title;
        location = location ?? (roomModel.RoomNumber ?? "");
        price = price ?? (roomModel.Price.ToString("N0") + " " + (roomModel.PriceUnit ?? ""));
        // choose main image if available
        var mainImg = roomModel.RoomImages != null ? roomModel.RoomImages.OrderBy(r => r.DisplayOrder).FirstOrDefault() : null;
        imageUrl = imageUrl ?? (mainImg != null ? Url.Content("~/" + mainImg.ImageUrl.TrimStart('~', '/')) : Url.Content("~/public/rooms/placeholder.jpg"));
        detailsUrl = detailsUrl ?? Url.Action("RoomDetails", "Guest_65133295", new { id = roomModel.RoomID });
    }

    // Fallbacks
    imageUrl = imageUrl ?? Url.Content("~/public/rooms/placeholder.jpg");
    title = title ?? "Listing";
    location = location ?? "";
    price = price ?? "";
}

<div class="card overflow-hidden">
    <div class="card-image-wrap">
        <img src="@imageUrl" alt="@title" style="width:100%;height:180px;object-fit:cover;" />
    </div>
    <div class="p-4">
        <h3 class="font-semibold">@title</h3>
        <div class="text-sm text-text-secondary">@location</div>
        <div class="mt-3 flex items-center justify-between">
            <div class="text-lg font-bold">@price</div>
            <a href="@detailsUrl" class="btn btn-secondary">View Details</a>
        </div>
    </div>
</div>

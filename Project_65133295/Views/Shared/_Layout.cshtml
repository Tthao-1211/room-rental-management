<!DOCTYPE html>
@{
    // Helper to determine active class for navigation links
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    Func<string, string, string> GetNavClass = (ctrl, act) => {
        bool isActive = string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(act, currentAction, StringComparison.OrdinalIgnoreCase);
        return isActive ? "text-base font-bold text-navy transition" : "text-base font-medium text-sky hover:text-ice transition";
    };
    
    Func<string, string, string> GetMobileNavClass = (ctrl, act) => {
        bool isActive = string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(act, currentAction, StringComparison.OrdinalIgnoreCase);
        return isActive 
            ? "block px-4 py-2 text-sm font-bold text-navy bg-ice rounded-lg transition" 
            : "block px-4 py-2 text-sm font-medium text-sky hover:bg-ice hover:text-navy rounded-lg transition";
    };
}
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Thanh Thảo Stay</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#053B4A',
                        'primary-hover': '#042F3B',
                        secondary: '#D7B57A',
                        'secondary-hover': '#C9A46B',
                        background: '#F8F6F2',
                        surface: '#FFFFFF',
                        border: '#E8E3D9',
                        'text-primary': '#17303A',
                        'text-secondary': '#5C6B73',
                        'text-muted': '#8A959C',
                        success: '#2E7D32',
                        warning: '#E6A23C',
                        danger: '#D64545'
                    },
                    fontFamily: {
                        heading: ['"Playfair Display"', 'serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    },
                    borderRadius: {
                        'card': '16px'
                    },
                    boxShadow: {
                        'card-subtle': '0 6px 18px rgba(16,24,40,0.06)'
                    },
                    container: {
                        center: true,
                        padding: '1rem',
                        screens: {
                            lg: '1400px'
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="~/Content/luxury-theme.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
    <style>
        .glassmorphism {
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .navbar-scrolled {
            background: linear-gradient(90deg, #ffffff, #FFF8E7) !important;
            box-shadow: 0 2px 10px rgba(201,168,76,0.15);
            border-bottom: 2px solid #C9A84C;
        }

        /* Small utility to render 1.5px border where needed */
        .border-1-5 { border-width: 1.5px; }

        /* Ensure mobile menu button is keyboard accessible */
        #mobile-menu-btn { outline: none; }
    </style>
</head>
<body class="font-sans bg-background text-text-primary">
    
    @Html.Partial("_Navbar")
    
    <!-- Global Error Message (Unauthorized access) -->
    @if (TempData["Error"] != null)
    {
        <div class="fixed top-20 right-4 z-[100]">
            <div class="bg-red-600 text-white px-6 py-3 rounded-lg shadow-2xl flex items-center space-x-3 border-2 border-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <span class="font-bold">@TempData["Error"]</span>
            </div>
        </div>
    }

    <!-- Main Content (with top padding for fixed navbar) -->
    <main class="pt-20">
        <div class="container-max">
            @RenderBody()
        </div>
    </main>
    
    <!-- Footer -->
    <footer class="site-footer mt-12">
        <div class="footer-container">
            <div>
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                    <div style="width:44px;height:44px;border-radius:9999px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:transparent;border:1px solid rgba(255,255,255,0.08);">
                        <img src="~/public/logo.jpg" alt="ThanhThao Stay" style="width:44px;height:44px;object-fit:cover;display:block;" />
                    </div>
                    <div>
                        <div style="font-family:Playfair Display, serif; font-weight:700;">ThanhThao Stay</div>
                        <div style="opacity:0.9; margin-top:6px; max-width:320px;">Trusted room rental management system delivering premium stays and reliable management tools for property owners and guests.</div>
                    </div>
                </div>
            </div>

            <div>
                <h4>Quick Links</h4>
                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
                    <li><a href="@Url.Action("Index", "Guest_65133295")">Home</a></li>
                    <li><a href="@Url.Action("SearchRoom", "Guest_65133295")">Rooms</a></li>
                    <li><a href="@Url.Action("BookingGuide", "Guest_65133295")">Booking Guide</a></li>
                </ul>
            </div>

            <div>
                <h4>Contact</h4>
                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
                    <li>Phone: 0764307704</li>
                    <li>Email: ptthanhthaoxxx@gmail.com</li>
                    <li>Address: 02 Đoàn Trần Nghiệp, Vĩnh Phước, TP. Nha Trang</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom" style="max-width:1400px;margin:18px auto 0;padding:0 16px;">
            <div>&copy; @DateTime.Now.Year ThanhThao Stay</div>
            <div style="display:flex;gap:16px;">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    
    <!-- Custom Scripts -->
    <script>
        // Simple sticky shadow only — do not change navbar background
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('navbar');
            if (!navbar) return;
            if (window.scrollY > 10) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        });
    </script>
    
    @RenderSection("scripts", required: false)
</body>
</html>
